{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix holospace/client install",
  "buildCommand": "npm --prefix holospace/client run build",
  "outputDirectory": "holospace/client/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
